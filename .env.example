# 이 파일을 `.env.local`로 복사한 뒤 REPLACE_ME 항목만 입력하세요.
# `.env.local`은 Git에 커밋하거나 채팅/문서로 공유하지 마세요.

# Supabase > Connect 또는 Integrations > Data API > Project URL
# 공개 가능한 프로젝트 식별 URL입니다.
NEXT_PUBLIC_SUPABASE_URL=https://busexvivefwyzkexjaqx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key
# `sb_publishable_...` 형식이며 브라우저에서 사용됩니다(RLS 적용).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Supabase > Project Settings > API Keys > Secret key
# `sb_secret_...` 형식입니다. 서버 전용이며 NEXT_PUBLIC_을 붙이면 안 됩니다.
# GitHub에 커밋하거나 브라우저 코드, URL, 채팅에 절대 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# 관리자(/admin) 로그인용 비밀번호
# 행사명, 생일처럼 추측 가능한 값 대신 16자 이상의 고유한 값을 권장합니다.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
